# Copie ce fichier en .env pour tester en local, et colle les mêmes variables
# dans Vercel > Project > Settings > Environment Variables pour la prod.
# Sans aucune variable, l'app tourne en mode démo (données d'exemple).

# Code d'accès que tu tapes une fois dans l'app (invente une longue chaîne)
APP_KEY=change-moi-par-une-longue-phrase

# Ton prénom affiché dans « Bonjour ... »
DISPLAY_NAME=Sholy

# --- Claude (résumé + tri) ---
ANTHROPIC_API_KEY=
# Rapide et pas cher par défaut. Passe à claude-sonnet-5-5 pour un tri plus fin.
CLAUDE_MODEL=claude-haiku-5-5

# --- Gmail (IMAP + mot de passe d'application) ---
# Plusieurs comptes possibles, séparés par des virgules : adresse:motdepasse
GMAIL_ACCOUNTS=toi@gmail.com:abcdabcdabcdabcd

# --- Slack (token utilisateur xoxp-...) ---
SLACK_USER_TOKEN=

# --- Studio KLIMB (optionnel, voir README) ---
# Option A : une URL qui renvoie un tableau JSON de projets
STUDIO_JSON_URL=
# Option B : la base Supabase derrière l'app Lovable
STUDIO_SUPABASE_URL=
STUDIO_SUPABASE_KEY=
STUDIO_TABLE=projects

# --- Règles de tri (avant l'IA) ---
# Domaines ou mots dans l'expéditeur qui comptent toujours (clients, collègues)
PRIORITY_SENDERS=goklimb.com,qantum,illicado,dougs,firstrow,lumapps
# Mots-clés qui font remonter un mail
PRIORITY_KEYWORDS=urgent,asap,deadline,bat,validation,retour,devis,facture,comité
# Fenêtre de lecture en heures
LOOKBACK_HOURS=36
